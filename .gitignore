# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# --- Added alongside the settings work ---------------------------------
# A debug APK built from the project root during early testing. Release builds
# land in build/ and are already ignored, but a stray copy here would
# otherwise be committed as a 48 MB binary.
meridian-debug.apk
*.aab

# Signing material. The upload key must never reach the repository; losing it
# means Play Store can no longer verify updates to an existing listing.
android/key.properties
**/*.jks
**/*.keystore
**/*.p12

# Local configuration
.env
.env.*
!.env.example
# Kotlin build state from the Gradle plugin
android/.kotlin/
.kotlin/
